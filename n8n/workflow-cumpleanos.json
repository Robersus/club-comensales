{
  "name": "Club de Comensales — Cumpleaños del día",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Cada mañana",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "notes": "Se dispara a las 9:00 en la zona horaria del workflow. Revisa Settings > Timezone."
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Leer comensales",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 0],
      "notes": "Misma hoja donde escribe el workflow de registro."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cumple-hoy",
              "leftValue": "={{ $json.cumple_mmdd }}",
              "rightValue": "={{ $now.toFormat('MM-dd') }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "¿Cumple hoy?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [440, 0],
      "notes": "Compara cumple_mmdd (03-14) contra la fecha de hoy en el mismo formato. Solo pasan los que cumplen años."
    }
  ],
  "connections": {
    "Cada mañana": {
      "main": [[{ "node": "Leer comensales", "type": "main", "index": 0 }]]
    },
    "Leer comensales": {
      "main": [[{ "node": "¿Cumple hoy?", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
